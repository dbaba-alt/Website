<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Kamuela and Kohala Hongwanji Missions, concept redesign</title>
<meta name="description" content="Concept redesign of the Kamuela and Kohala Hongwanji Missions website: service times, locations and contact information.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@400;500;700&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{
  --mist:#EDF0EB;
  --paper:#F7F8F4;
  --ink:#1B2428;
  --ink-soft:#4A585C;
  --pasture:#2F4C3E;
  --pasture-deep:#213A2F;
  --indigo:#2A3B5C;
  --gold:#A87C1F;
  --gold-soft:#D9C48A;
  --line:#C9D1C8;
  --display:"Shippori Mincho","Hiragino Mincho ProN","Yu Mincho",Georgia,serif;
  --body:"Zen Kaku Gothic New","Hiragino Sans","Yu Gothic",system-ui,-apple-system,"Segoe UI",sans-serif;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--mist);color:var(--ink);font-family:var(--body);font-size:1.0625rem;line-height:1.65;-webkit-font-smoothing:antialiased}
a{color:inherit}
:focus-visible{outline:3px solid var(--indigo);outline-offset:3px;border-radius:2px}
.skip{position:absolute;left:-999px;top:0;background:var(--ink);color:#fff;padding:.75rem 1rem;z-index:20}
.skip:focus{left:0}
.wrap{max-width:1120px;margin:0 auto;padding:0 24px}
[hidden]{display:none !important}

/* concept notice */
.notice{background:var(--ink);color:#E8ECE6;font-size:.9rem;text-align:center;padding:.6rem 24px}

/* header */
header.site{background:var(--mist)}
header.site .wrap{display:flex;align-items:center;justify-content:space-between;gap:1.5rem;padding-top:20px;padding-bottom:20px;flex-wrap:wrap}
.wordmark{font-family:var(--display);font-weight:700;font-size:1.15rem;text-decoration:none;line-height:1.2}
.wordmark small{display:block;font-family:var(--body);font-weight:400;font-size:.8rem;color:var(--ink-soft)}
nav ul{display:flex;gap:1.75rem;list-style:none;margin:0;padding:0;flex-wrap:wrap}
nav a{text-decoration:none;font-weight:500;padding:.35rem 0;border-bottom:2px solid transparent}
nav a:hover{border-bottom-color:var(--gold)}

/* hero */
.hero{position:relative;overflow:hidden}
.hero .wrap{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);gap:48px;align-items:start;padding-top:56px;padding-bottom:200px}
.hero h1{font-family:var(--display);font-weight:700;font-size:clamp(2.4rem,5.2vw,4.1rem);line-height:1.12;letter-spacing:-.01em;margin:0 0 1.25rem;max-width:14ch}
.hero .lede{font-size:1.2rem;max-width:34rem;color:var(--ink-soft);margin:0 0 2rem}
.actions{display:flex;gap:.9rem;flex-wrap:wrap;margin-bottom:2.5rem}
.btn{display:inline-block;text-decoration:none;font-weight:700;padding:.85rem 1.4rem;border-radius:4px;border:2px solid var(--pasture);transition:background .15s,color .15s}
.btn.primary{background:var(--pasture);color:#fff}
.btn.primary:hover{background:var(--pasture-deep)}
.btn.ghost{color:var(--pasture)}
.btn.ghost:hover{background:var(--pasture);color:#fff}

.next{display:none;border-left:3px solid var(--gold);padding:.2rem 0 .2rem 1.1rem;max-width:26rem}
.next.on{display:block}
.next p{margin:0}
.next .when{font-family:var(--display);font-weight:700;font-size:1.55rem;line-height:1.25}
.next .where{color:var(--ink-soft)}

.nembutsu{justify-self:center;display:block;text-align:center}
.nembutsu .glyphs{display:block;writing-mode:vertical-rl;text-orientation:upright;white-space:nowrap;font-family:"Shippori Mincho","Hiragino Mincho ProN","Yu Mincho","Noto Serif CJK JP","Noto Serif CJK TC","Noto Serif JP",serif;font-weight:500;font-size:clamp(3rem,6.5vw,5.5rem);line-height:1.2;letter-spacing:.04em;color:var(--indigo);margin:0 auto;height:6.3em;width:1.3em;border-right:2px solid var(--gold);padding-right:.35em;box-sizing:content-box;animation:rise 2.2s ease-out both}
.nembutsu .say{font-size:.95rem;color:var(--ink-soft);margin:1rem 0 0;text-align:center}
@keyframes rise{from{opacity:0;transform:translateY(-10px)}to{opacity:1;transform:none}}

.hills{position:absolute;left:0;right:0;bottom:0;height:180px;pointer-events:none}
.hills svg{display:block;width:100%;height:100%}

/* services */
.services{background:var(--pasture-deep);color:#EEF2EC;padding:72px 0 80px}
.services h2,.visit h2,.contact h2,.expect h2,.news h2,.activities h2{font-family:var(--display);font-weight:700;font-size:clamp(1.8rem,3.4vw,2.5rem);line-height:1.2;margin:0 0 .6rem}
.services .intro{max-width:36rem;color:#C9D6CC;margin:0 0 3rem}
.schedule{display:grid;grid-template-columns:repeat(var(--n,2),minmax(0,1fr));gap:0}
.temple{padding:0 40px}
.temple:first-child{padding-left:0}
.temple:last-child{padding-right:0}
.temple + .temple{border-left:1px solid var(--gold)}
.temple h3{font-family:var(--display);font-weight:700;font-size:1.7rem;margin:0 0 1rem}
.temple .days{font-family:var(--display);font-size:1.45rem;line-height:1.3;margin:0}
.temple .time{font-size:1.15rem;color:#C9D6CC;margin:.2rem 0 1rem}
.temple .place{margin:0;color:#C9D6CC}
.upcoming{margin-top:3.5rem}
.upcoming h3{font-family:var(--display);font-size:1.4rem;margin:0 0 1rem}
.upcoming table{width:100%;border-collapse:collapse;max-width:44rem}
.upcoming th{font-weight:500;text-align:left;color:#C9D6CC;font-size:.95rem;padding:.4rem 1rem .4rem 0;border-bottom:1px solid rgba(255,255,255,.25)}
.upcoming td{padding:.7rem 1rem .7rem 0;border-bottom:1px solid rgba(255,255,255,.14);vertical-align:top}
.upcoming td small{display:block;color:var(--gold-soft);font-size:.9rem}
.upcoming tr.cancelled td:first-child,.upcoming tr.cancelled td:nth-child(2){text-decoration:line-through;text-decoration-color:rgba(255,255,255,.5);color:#C9D6CC}
.upcoming tr.cancelled td:nth-child(3){color:var(--gold-soft)}
.upcoming .note{font-size:.92rem;color:#C9D6CC;margin:1rem 0 0;max-width:40rem}

/* news */
.news{padding:72px 0 8px}
.news .item{border-left:3px solid var(--gold);padding:.2rem 0 .2rem 1.1rem;margin:1.6rem 0 0;max-width:42rem}
.news .item h3{font-family:var(--display);font-weight:700;font-size:1.35rem;line-height:1.3;margin:0}
.news .item .posted{font-size:.9rem;color:var(--ink-soft);margin:.1rem 0 .35rem}
.news .item p.body{margin:0;color:var(--ink-soft)}

/* expect */
.expect{padding:80px 0 24px}
.expect .grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.3fr);gap:56px;align-items:start}
.expect p.lead{color:var(--ink-soft);margin:0;max-width:26rem}
.expect dl{margin:0}
.expect dt{font-family:var(--display);font-weight:700;font-size:1.3rem;margin-top:1.6rem}
.expect dt:first-child{margin-top:0}
.expect dd{margin:.25rem 0 0;color:var(--ink-soft);max-width:34rem}
.expect .ask{margin-top:2.2rem;padding-top:1.4rem;border-top:1px solid var(--line);max-width:34rem}

/* temple activities gallery */
.activities{background:var(--paper);border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:72px 0 80px;margin-top:64px}
.activities .intro{max-width:36rem;color:var(--ink-soft);margin:0}
.gallery{list-style:none;margin:2.2rem 0 0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:28px 24px}
.photo{margin:0}
.photo a{display:block;text-decoration:none}
.photo img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:4px;background:var(--line);border:1px solid var(--line);transition:transform .2s}
.photo a:hover img{transform:translateY(-2px)}
.photo figcaption{margin-top:.6rem;font-size:.98rem;line-height:1.45}
.photo .pdate{display:block;font-size:.88rem;color:var(--ink-soft)}
.gallery-empty{margin:2.2rem 0 0;padding:1.4rem 0 0;border-top:1px solid var(--line);color:var(--ink-soft);max-width:34rem}

dialog#lightbox{border:0;padding:0;background:var(--paper);color:var(--ink);border-radius:6px;max-width:min(94vw,1040px);width:auto;overflow:hidden}
dialog#lightbox::backdrop{background:rgba(27,36,40,.82)}
#lightbox .frame{padding:14px 14px 18px}
#lightbox img{display:block;max-width:100%;max-height:72vh;margin:0 auto;object-fit:contain}
#lightbox .cap{margin:.9rem .2rem 0;font-size:1rem}
#lightbox .cap small{display:block;color:var(--ink-soft)}
#lightbox .close{display:block;margin:0 0 10px auto;font:inherit;font-weight:700;background:transparent;color:var(--pasture);border:2px solid var(--pasture);border-radius:4px;padding:.4rem .9rem;cursor:pointer}
#lightbox .close:hover{background:var(--pasture);color:#fff}

/* visit */
.visit{padding:72px 0 24px}
.places{display:grid;grid-template-columns:repeat(var(--n,2),minmax(0,1fr));gap:48px;margin-top:2rem}
.place h3{font-family:var(--display);font-size:1.5rem;margin:0 0 .6rem}
.place address{font-style:normal;margin:0 0 1rem}
.place .mail{color:var(--ink-soft);font-size:.95rem;margin:0 0 1.2rem}
.place a.maplink{font-weight:700;color:var(--indigo);text-underline-offset:4px;text-decoration-thickness:2px}

/* contact */
.contact{padding:72px 0 88px}
.contact .box{background:var(--paper);border:1px solid var(--line);border-radius:6px;padding:40px;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr);gap:40px;align-items:start}
.contact p{margin:0 0 1rem;max-width:30rem}
.contact .rev{font-family:var(--display);font-weight:700;font-size:1.3rem}
.contact ul{list-style:none;margin:0;padding:0}
.contact li{padding:.9rem 0;border-bottom:1px solid var(--line)}
.contact li:first-child{padding-top:0}
.contact li:last-child{border-bottom:0;padding-bottom:0}
.contact .label{display:block;font-size:.92rem;color:var(--ink-soft)}
.contact a.big{font-weight:700;font-size:1.15rem;text-underline-offset:4px;word-break:break-word}

.loaderror{background:var(--paper);border:1px solid var(--line);border-left:3px solid var(--gold);margin:24px auto;max-width:1072px;padding:1rem 1.2rem}

footer{background:var(--ink);color:#C9D1CA;padding:32px 0;font-size:.95rem}
footer .wrap{display:flex;justify-content:space-between;gap:1.5rem;flex-wrap:wrap}
footer p{margin:0;max-width:40rem}
footer a{color:#fff;text-underline-offset:4px}

@media (max-width:820px){
  .hero .wrap{grid-template-columns:1fr;padding-top:36px;padding-bottom:170px}
  .nembutsu{justify-self:start;order:-1;display:flex;align-items:flex-end;gap:1rem}
  .nembutsu .glyphs{font-size:2.2rem;margin:0}
  .nembutsu .say{text-align:left;margin:0;max-width:8rem}
  .schedule,.places,.expect .grid,.contact .box{grid-template-columns:1fr}
  .temple,.temple:first-child,.temple:last-child{padding:0}
  .temple + .temple{border-left:0;border-top:1px solid var(--gold);padding-top:2rem;margin-top:2rem}
  .contact .box{padding:28px 22px;gap:28px}
  nav ul{gap:1.1rem}
  .gallery{grid-template-columns:repeat(auto-fill,minmax(200px,1fr))}
}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  .nembutsu .glyphs{animation:none}
  .photo img{transition:none}
}
</style>
</head>
