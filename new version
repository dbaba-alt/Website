<script>
(function(){
  var S = window.SITE, L = window.SiteLogic;
  if(!S || !L){ document.getElementById("loadError").hidden = false; return; }

  function el(tag, cls, text){
    var e = document.createElement(tag);
    if(cls) e.className = cls;
    if(text != null) e.textContent = text;
    return e;
  }
  function longDate(ts){
    return new Date(ts).toLocaleDateString("en-US",{weekday:"long",month:"long",day:"numeric",timeZone:"UTC"});
  }
  function shortDate(ts){
    return new Date(ts).toLocaleDateString("en-US",{year:"numeric",month:"long",day:"numeric",timeZone:"UTC"});
  }
  var today = L.hawaiiToday();

  // concept banner on/off
  if(S.showConceptNotice === false){
    var n1 = document.getElementById("conceptNotice"), n2 = document.getElementById("conceptFooter");
    if(n1) n1.remove();
    if(n2) n2.remove();
  }

  // service cards + visit section
  try{
    var temples = S.temples || [];
    var sched = document.getElementById("schedule"), places = document.getElementById("places");
    sched.style.setProperty("--n", temples.length || 1);
    places.style.setProperty("--n", temples.length || 1);
    temples.forEach(function(t){
      var card = el("div","temple");
      card.appendChild(el("h3",null,t.name));
      card.appendChild(el("p","days",L.describeSundays(t.sundays)));
      card.appendChild(el("p","time",t.time));
      card.appendChild(el("p","place",t.street+", "+String(t.city||"").split(",")[0]));
      sched.appendChild(card);

      var pl = el("div","place");
      pl.appendChild(el("h3",null,t.fullName || t.name));
      var addr = el("address");
      addr.appendChild(document.createTextNode(t.street));
      addr.appendChild(document.createElement("br"));
      addr.appendChild(document.createTextNode(t.city));
      pl.appendChild(addr);
      if(t.mailing) pl.appendChild(el("p","mail","Mailing address: "+t.mailing));
      var a = el("a","maplink","Open "+t.name+" in Maps");
      a.href = "https://www.google.com/maps/search/?api=1&query="+encodeURIComponent(t.mapQuery || (t.street+" "+t.city));
      pl.appendChild(a);
      places.appendChild(pl);
    });
  }catch(e){ console.warn("Temples section:", e); }

  // next service + upcoming table
  try{
    var list = L.buildUpcoming(S, today, 6);
    var firstOk = list.filter(function(r){ return !r.cancelled; })[0];
    if(firstOk){
      document.getElementById("nextLabel").textContent = firstOk.ts === today ? "Service today" : "Next service";
      document.getElementById("nextWhen").textContent = longDate(firstOk.ts);
      document.getElementById("nextWhere").textContent = firstOk.temple + (firstOk.time ? ", " + firstOk.time : "") + (firstOk.note ? " (" + firstOk.note + ")" : "");
      document.getElementById("next").classList.add("on");
    }
    if(list.length){
      var body = document.getElementById("upcomingBody");
      list.slice(0,6).forEach(function(r){
        var tr = el("tr", r.cancelled ? "cancelled" : "");
        tr.appendChild(el("td",null,longDate(r.ts)));
        tr.appendChild(el("td",null,r.temple));
        var td = el("td");
        if(r.cancelled){
          td.appendChild(document.createTextNode("No service"));
          if(r.note) td.appendChild(el("small",null,r.note));
        }else{
          td.appendChild(document.createTextNode(r.time));
          if(r.note) td.appendChild(el("small",null,r.note));
        }
        tr.appendChild(td);
        body.appendChild(tr);
      });
      document.getElementById("upcoming").hidden = false;
    }
  }catch(e){ console.warn("Schedule:", e); }

  // announcements
  try{
    var items = L.activeAnnouncements(S.announcements, today);
    if(items.length){
      var box = document.getElementById("newsList");
      items.forEach(function(a){
        var item = el("div","item");
        item.appendChild(el("h3",null,a.title));
        var pd = L.parseISO(a.date);
        if(pd !== null) item.appendChild(el("p","posted","Posted "+shortDate(pd)));
        if(a.text) item.appendChild(el("p","body",a.text));
        box.appendChild(item);
      });
      document.getElementById("news").hidden = false;
    }
  }catch(e){ console.warn("Announcements:", e); }

  // gallery
  try{
    var photos = (S.photos || []).filter(function(p){ return p && p.file; });
    var gallery = document.getElementById("gallery"), empty = document.getElementById("galleryEmpty");
    var dlg = document.getElementById("lightbox"), dImg = document.getElementById("lightboxImg"), dCap = document.getElementById("lightboxCap");
    var canModal = dlg && typeof dlg.showModal === "function";
    if(!photos.length){ empty.hidden = false; }
    else{
      gallery.hidden = false;
      var folder = S.photoFolder == null ? "images/" : S.photoFolder;
      photos.forEach(function(p){
        var src = folder + p.file;
        var li = el("li");
        var fig = el("figure","photo");
        var a = el("a"); a.href = src; a.target = "_blank"; a.rel = "noopener";
        var img = el("img"); img.src = src; img.loading = "lazy"; img.decoding = "async";
        img.alt = p.alt || p.caption || "Temple activity photo";
        img.addEventListener("error", function(){ console.warn("Photo not found:", src); li.remove(); if(!gallery.children.length){ gallery.hidden = true; empty.hidden = false; } });
        a.appendChild(img);
        fig.appendChild(a);
        var dt = L.parseISO(p.date);
        if(p.caption || dt !== null){
          var fc = el("figcaption");
          if(p.caption) fc.appendChild(document.createTextNode(p.caption));
          if(dt !== null) fc.appendChild(el("span","pdate",shortDate(dt)));
          fig.appendChild(fc);
        }
        a.addEventListener("click", function(ev){
          if(!canModal) return;
          ev.preventDefault();
          dImg.src = src; dImg.alt = img.alt;
          dCap.textContent = "";
          if(p.caption) dCap.appendChild(document.createTextNode(p.caption));
          if(dt !== null) dCap.appendChild(el("small",null,shortDate(dt)));
          dlg.showModal();
        });
        li.appendChild(fig);
        gallery.appendChild(li);
      });
      if(canModal){
        document.getElementById("lightboxClose").addEventListener("click", function(){ dlg.close(); });
        dlg.addEventListener("click", function(ev){ if(ev.target === dlg) dlg.close(); });
      }
    }
  }catch(e){ console.warn("Gallery:", e); }
})();
</script>
</body>
</html>
